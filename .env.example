# Variáveis lidas pelo docker compose. Copie para .env e ajuste se precisar.

# UID/GID do seu usuário, para os arquivos criados nos containers não ficarem com dono root.
UID=1000
GID=1000

# Credenciais do PostgreSQL local. Sem DB_PASSWORD, o compose usa um padrão só de desenvolvimento.
# A senha é repassada ao backend/.env pelo entrypoint do container.
DB_DATABASE=estudo
DB_TEST_DATABASE=estudo_test
DB_USERNAME=estudo
DB_PASSWORD=

# Portas expostas no host.
APP_FORWARD_PORT=8080
FRONTEND_FORWARD_PORT=4300
DB_FORWARD_PORT=5442
REDIS_FORWARD_PORT=6389
